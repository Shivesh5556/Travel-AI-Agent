# ================================================================
#  Ghumi Ghumi - environment settings (v24)
#  Copy this file to ".env" and fill in the THREE required keys below.
#  All three are free and need no credit card.
# ================================================================

# ---------- REQUIRED (when STRICT_MODE=true) ----------

# 1. GROQ - the language model. It reads the traveller's notes, decides which
#    tools to call, writes the day-by-day text and reviews the plan.
#    Free, no credit card. https://console.groq.com/keys
#    Sign in with Google -> API Keys -> Create API Key.
GROQ_API_KEY=
# Groq retires models often. Leave this as-is: on startup the app asks Groq
# which models are live and picks a working one automatically.
GROQ_MODEL=openai/gpt-oss-120b

# 2. DUFFEL - flight search.
#    Free sandbox. https://app.duffel.com/join
#    After signing up: Developers -> Access tokens -> create a TEST token
#    (starts with "duffel_test_").
#    NOTE: a TEST token returns Duffel's test airline with test prices. The
#    app labels those "demo fare (test data)" - they are not real fares.
#    Real fares need a LIVE token (Duffel account verification).
DUFFEL_API_KEY=

# 3. GEOAPIFY - a second, independent places / hotels source merged in
#    alongside the keyless OpenStreetMap + Wikipedia + Wikivoyage + Wikidata.
#    CONFIRMED free, no credit card, 3,000 requests/day.
#    Sign up: https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# Strict mode refuses to plan a trip unless the three keys above are
# present, instead of quietly planning off a smaller pool of sources.
# Set it to false for a quick demo with no keys (everything estimated and
# labelled). The test suite sets this to false so tests never need a key.
STRICT_MODE=true


# ---------- OPTIONAL ----------

# TICKETMASTER - live events (concerts, festivals) ON your trip dates.
#    Optional since v24: it lists very few Indian events, so it no longer
#    blocks planning. Free, no card, 5,000 calls/day.
#    Sign up: https://developer-acct.ticketmaster.com/user/register
TICKETMASTER_API_KEY=

# 4. FOURSQUARE - genuinely optional, kept out of strict mode on purpose.
#    Attractions/restaurants already work fully without it. Add this key and Foursquare gets merged in as one more
#    independent cross-check - leave it blank and nothing else changes.
#
#    NOT confirmed free-without-card. Foursquare's own pricing page
#    (location.foursquare.com/pricing) is "$200/month free credit, then
#    pay-as-you-go" - not an unconditional free tier like Geoapify. Only fill this in if you're comfortable with that.
#    Sign up: https://location.foursquare.com/developer/
FOURSQUARE_API_KEY=
#    What it adds in v23: visitor RATING and POPULARITY for attractions, and a
#    rating + price tier for hotels. Those are real quality signals, so places
#    and stays that people actually rate highly rank above merely-nearby ones.
#    Without a key the same ranking still runs on OSM + Geoapify + Wikipedia +
#    Wikivoyage + the curated landmark lists.
#    Foursquare has moved to a new API host. If your key is for the new one, set:
#      FOURSQUARE_URL=https://places-api.foursquare.com/places/search
#      FOURSQUARE_API_VERSION=2025-06-17
FOURSQUARE_URL=
FOURSQUARE_API_VERSION=

# 5. RAZORPAY - the checkout step. TEST MODE ONLY, no real money can move.
#    https://dashboard.razorpay.com -> turn the "Test Mode" toggle ON
#    -> Settings -> API Keys. Keys start with "rzp_test_".
#    Leave blank and the planner works fine, checkout is just switched off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 6. DATABASE - SQLite by default, no setup at all.
#    For Postgres: postgresql+asyncpg://user:pass@localhost:5432/ghumi
#    (and uncomment asyncpg in requirements.txt)
DATABASE_URL=sqlite+aiosqlite:///./ghumi.db

# 7. REDIS - leave blank to use an in-memory cache instead.
REDIS_URL=
CACHE_TTL_SECONDS=3600

# 8. Where the React dev server runs.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 9. Agent limits.
MAX_AGENT_STEPS=12
MAX_REPLAN_ROUNDS=3
HTTP_TIMEOUT=20

# 10. Your email, sent to OpenStreetMap's city search (Nominatim) so they can
#     contact you instead of blocking you. Without it the city autocomplete
#     can return HTTP 403 - then the app falls back to Geoapify automatically.
NOMINATIM_CONTACT=
#     ^ IMPORTANT since v27: Wikipedia and Wikivoyage answer 403 without a
#       contact in the User-Agent, and plans lose two of their best sources.

# 11. Public deployment safety (v24).
#     Every plan costs LLM tokens, so one browser / IP may start at most this
#     many plans per hour (HTTP 429 after that).
MAX_TRIPS_PER_HOUR=20
#     Trips are view-once; anything older than this is deleted automatically.
TRIP_TTL_HOURS=6
#     If set, /api/metrics and a full /api/monitor/run need the header
#     "X-Admin-Token: <value>". Leave blank on your laptop; SET IT when deployed.
ADMIN_TOKEN=